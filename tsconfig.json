{
  "extends": "adamantite/typescript",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "allowedUnstableApis": [
          "@effect/platform-node",
          "@effect/platform-node-shared/NodeStream",
          "effect/cli",
          "effect/encoding/Json5",
          "effect/encoding/Tar",
          "effect/FileSystem",
          "effect/http",
          "effect/Path",
          "effect/PlatformError",
          "effect/process",
          "effect/SemVer",
          "effect/SemVerRange",
          "effect/Terminal"
        ]
      }
    ]
  },
  "include": ["src", "scripts", "*.config.ts"],
  "exclude": ["node_modules", "dist", ".packref"]
}

{
  "extends": "adamantite/typescript",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "allowedUnstableApis": ["effect/cli", "effect/http", "effect/process"]
      }
    ]
  },
  "include": ["src", "scripts", "*.config.ts"],
  "exclude": ["node_modules", "dist", ".packref"]
}

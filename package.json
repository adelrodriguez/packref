{
  "name": "packref",
  "version": "0.3.0",
  "description": "Local, versioned package references for your agents",
  "keywords": [
    "agents",
    "cli",
    "dependencies",
    "npm",
    "reference",
    "source"
  ],
  "homepage": "https://github.com/adelrodriguez/packref#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/packref/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/packref.git"
  },
  "bin": {
    "packref": "bin/packref"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "tsdown",
    "build:verify": "pnpm run build && node scripts/verify-build.ts",
    "bump:deps": "pnpm update --interactive",
    "check": "adamantite check",
    "dev": "tsdown --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "changeset publish",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit",
    "version": "changeset version && pnpm run format"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "giget": "3.3.1",
    "jsonc-parser": "3.3.1",
    "nanotar": "0.3.0",
    "nypm": "0.6.9",
    "picocolors": "1.1.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "4.1.11",
    "adamantite": "0.37.0",
    "figlet": "1.11.4",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "unplugin-macros": "0.23.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.0.0-rc.6"
}

{
  "name": "packref",
  "version": "0.0.0",
  "description": "Local, versioned package references for your agents",
  "keywords": [
    "agents",
    "cli",
    "dependencies",
    "npm",
    "reference",
    "source"
  ],
  "homepage": "https://github.com/adelrodriguez/packref#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/packref/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/packref.git"
  },
  "bin": {
    "packref": "bin/packref"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "bunup",
    "bump:deps": "bun update --interactive",
    "check": "adamantite check",
    "dev": "bunup --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "version": "changeset version && bun run format"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@effect/platform-node": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102",
    "giget": "^3.3.1",
    "jsonc-parser": "3.3.1",
    "nanotar": "^0.3.0",
    "nypm": "^0.6.9",
    "picocolors": "1.1.1",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/bun": "1.3.14",
    "@types/semver": "7.8.0",
    "adamantite": "^0.33.2",
    "bunup": "0.16.32",
    "figlet": "1.11.4",
    "knip": "6.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "type-fest": "5.8.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.1"
}

{
  "name": "packref",
  "version": "0.3.7",
  "description": "Local, versioned package references for your agents",
  "keywords": [
    "agents",
    "cli",
    "dependencies",
    "npm",
    "reference",
    "source"
  ],
  "homepage": "https://github.com/adelrodriguez/packref#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/packref/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/packref.git"
  },
  "bin": {
    "packref": "bin/packref"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "tsdown",
    "build:verify": "pnpm run build && node scripts/verify-build.ts",
    "bump:deps": "pnpm update --interactive",
    "check": "adamantite check",
    "dev": "tsdown --watch",
    "fix": "adamantite fix",
    "prepare": "adamantite prepare",
    "release": "changeset publish",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "version": "changeset version && pnpm run fix"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.54.0",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "adamantite": "0.44.0",
    "figlet": "1.12.0",
    "knip": "6.42.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "unplugin-macros": "0.23.4",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.0.0-rc.6"
}
